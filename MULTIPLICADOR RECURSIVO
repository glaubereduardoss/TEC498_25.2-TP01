module MultiplicadorRECURSIVOTESTE (
    input [7:0] A, B,
    input CLK, START, 
    output [7:0] RESULT,
);

    wire [7:0] regA_out, regB_out, regR_out;
    wire [7:0] soma_out, sub_out;
    wire carry_soma, carry_sub, enable;

    // Registradores
    Registrador8BIT_PALAVRA_A palavraA(.D(A), .CLK(START), .Q(regA_out));
	 
	 
    Registrador8BIT_PALAVRA_B palavrab(.D(sub_out), .CLK(CLK), .Q(regB_out));
	 
	 
    Registrador8BIT_PALAVRA_ACUMULADOR acumulando(.D(soma_out), .CLK(CLK), .Q(regR_out));

    //SOMA = ACUMULADOR SOMADO COM O VALOR FIXO DO "A", "B" VEZES.
    Somador8 somador(regR_out, regA_out, 1'b0, soma_out, carry_soma);

    //SUBTRAÇÃO = SUBTRAINDO O B A CADA VEZ QUE O VALOR DE "A" É SOMADO COM O ACUMULADOR.
    Subtrator8 subtrator(regB_out, 8'b00000001, 1'b0, sub_out, carry_sub);
	 
	 //FALTA DETECTOR DE ZERO...
	 //MULTIPLEXADORES
	 //UNIDADE DE CONTROLE

    // Saída final
    and(RESULT[0], regR_out[0]);
    and(RESULT[1], regR_out[1]);
    and(RESULT[2], regR_out[2]);
    and(RESULT[3], regR_out[3]);
    and(RESULT[4], regR_out[4]);
    and(RESULT[5], regR_out[5]);
    and(RESULT[6], regR_out[6]);
    and(RESULT[7], regR_out[7]);

endmodule

module Registrador8BIT_PALAVRA_B (
    input  wire [7:0] D,      // Entrada de dados de 8 bits
    input  wire       CLK,    // Sinal de clock (compartilhado)
    output wire [7:0] Q,      // Saída registrada de 8 bits
    output wire [7:0] nQ      // Saída invertida de 8 bits
);

    // Instanciando 8 vezes o módulo FlipFlopDATA no formato solicitado.
    FlipFlopDATA ff_bit0(D(D[0]), CLK(CLK), Q(Q[0]), nQ(nQ[0]));
    FlipFlopDATA ff_bit1(D(D[1]), CLK(CLK), Q(Q[1]), nQ(nQ[1]));
    FlipFlopDATA ff_bit2(D(D[2]), CLK(CLK), Q(Q[2]), nQ(nQ[2]));
    FlipFlopDATA ff_bit3(D(D[3]), CLK(CLK), Q(Q[3]), nQ(nQ[3]));
    FlipFlopDATA ff_bit4(D(D[4]), CLK(CLK), Q(Q[4]), nQ(nQ[4]));
    FlipFlopDATA ff_bit5(D(D[5]), CLK(CLK), Q(Q[5]), nQ(nQ[5]));
    FlipFlopDATA ff_bit6(D(D[6]), CLK(CLK), Q(Q[6]), nQ(nQ[6]));
    FlipFlopDATA ff_bit7(D(D[7]), CLK(CLK), Q(Q[7]), nQ(nQ[7]));

endmodule

